{
  "name": "karaoke-queue",
  "version": "1.0.1",
  "description": "Fair queue manager for karaoke venues",
  "main": "build/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json && node build/scripts/copy-assets.js",
    "start": "npm run compile && electron .",
    "build": "npm run compile && electron-builder",
    "test:e2e": "npm run compile && node build/tests/electron-smoke.js",
    "test:e2e:headless": "env -u WAYLAND_DISPLAY xvfb-run -a npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.karaoke.queue",
    "productName": "Karaoke Queue",
    "win": {
      "target": "nsis"
    },
    "files": ["build/**/*"]
  }
}
