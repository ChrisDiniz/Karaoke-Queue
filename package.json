{
  "name": "karaoke-queue",
  "version": "1.0.1",
  "description": "Fair queue manager for karaoke venues",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test:e2e": "node tests/electron-smoke.cjs",
    "test:e2e:headless": "env -u WAYLAND_DISPLAY xvfb-run -a npm run test:e2e"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "com.karaoke.queue",
    "productName": "Karaoke Queue",
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "database.js",
      "preload.js",
      "src/**/*"
    ]
  }
}
